+func TestSplitClientHelloRecord(t *testing.T) {
+	const limit = 128
+	payload := make([]byte, handshakeHeaderLen+500)
+	payload[0] = tlsClientHelloType
+	payload[1] = 0
+	payload[2] = 1
+	payload[3] = 0xf4
+	for i := handshakeHeaderLen; i < len(payload); i++ {
+		payload[i] = byte(i)
+	}
+	record := make([]byte, tlsRecordHeaderLen+len(payload))
+	record[0], record[1], record[2] = tlsHandshakeRecordType, 0x03, 0x01
+	binary.BigEndian.PutUint16(record[3:5], uint16(len(payload)))
+	copy(record[tlsRecordHeaderLen:], payload)
+
+	frames, ok := splitClientHelloRecord(record, limit)
+	if !ok || len(frames) < 2 {
+		t.Fatalf("splitClientHelloRecord() = (%d frames, %t), want multiple frames", len(frames), ok)
+	}
+	var joined []byte
+	for i, frame := range frames {
+		if frame[0] != tlsHandshakeRecordType || frame[1] != record[1] || frame[2] != record[2] {
+			t.Fatalf("frame %d has unexpected TLS record header: %x", i, frame[:tlsRecordHeaderLen])
+		}
+		if int(binary.BigEndian.Uint16(frame[3:5])) != len(frame)-tlsRecordHeaderLen {
+			t.Fatalf("frame %d record length does not match payload", i)
+		}
+		if len(frame)-tlsRecordHeaderLen > limit {
+			t.Fatalf("frame %d payload is %d bytes, limit is %d", i, len(frame)-tlsRecordHeaderLen, limit)
+		}
+		joined = append(joined, frame[tlsRecordHeaderLen:]...)
+	}
+	if string(joined) != string(payload) {
+		t.Fatal("fragment payloads do not reconstruct the original ClientHello")
+	}
+}
+
+func TestEnabledTransportFragmentsClientHelloAndVerifiesCertificate(t *testing.T) {
+	t.Setenv(EnabledEnv, "1")
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, "registry test ok")
+	}))
+	t.Cleanup(server.Close)
+
+	parsedURL, err := url.Parse(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := parsedURL.Port()
+	cert, err := x509.ParseCertificate(server.TLS.Certificates[0].Certificate[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverName := ""
+	if len(cert.DNSNames) > 0 {
+		serverName = cert.DNSNames[0]
+	} else if len(cert.IPAddresses) > 0 {
+		serverName = cert.IPAddresses[0].String()
+	} else {
+		t.Fatal("test TLS certificate has no DNS or IP subject alternative name")
+	}
+	endpoint := "https://" + net.JoinHostPort(serverName, port) + "/v2/"
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	capture := &writeCapture{}
+	base := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots}}
+	base.DialContext = func(ctx context.Context, network, _ string) (net.Conn, error) {
+		conn, err := (&net.Dialer{}).DialContext(ctx, network, parsedURL.Host)
+		if err != nil {
+			return nil, err
+		}
+		return &capturedConn{Conn: conn, capture: capture}, nil
+	}
+
+	transport := WrapTransport(base)
+	if transport == base {
+		t.Fatal("enabled WrapTransport returned the unwrapped base transport")
+	}
+	resp, err := (&http.Client{Transport: transport}).Get(endpoint)
+	if err != nil {
+		t.Fatalf("verified HTTPS request through fragmented ClientHello failed: %v", err)
+	}
+	body, readErr := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	if readErr != nil {
+		t.Fatal(readErr)
+	}
+	if resp.StatusCode != http.StatusOK || string(body) != "registry test ok" {
+		t.Fatalf("unexpected HTTPS response: status=%s body=%q", resp.Status, body)
+	}
+
+	writes := capture.snapshot()
+	var helloRecords [][]byte
+	for _, write := range writes {
+		if len(write) >= tlsRecordHeaderLen && write[0] == tlsHandshakeRecordType {
+			helloRecords = append(helloRecords, write)
+			continue
+		}
+		if len(helloRecords) > 0 {
+			break
+		}
+	}
+	if len(helloRecords) < 2 {
+		t.Fatalf("observed %d outbound handshake records, want fragmented ClientHello records; writes=%d", len(helloRecords), len(writes))
+	}
+	var joined []byte
+	for i, record := range helloRecords {
+		if int(binary.BigEndian.Uint16(record[3:5])) != len(record)-tlsRecordHeaderLen {
+			t.Fatalf("wire record %d length header does not match bytes", i)
+		}
+		if len(record)-tlsRecordHeaderLen > defaultRecordPayloadLimit {
+			t.Fatalf("wire record %d payload exceeds configured limit", i)
+		}
+		joined = append(joined, record[tlsRecordHeaderLen:]...)
+	}
+	if len(joined) < handshakeHeaderLen || joined[0] != tlsClientHelloType {
+		t.Fatalf("observed records do not begin with a ClientHello: %x", joined[:min(len(joined), 8)])
+	}
+	helloLen := int(joined[1])<<16 | int(joined[2])<<8 | int(joined[3])
+	if helloLen != len(joined)-handshakeHeaderLen {
+		t.Fatalf("reassembled ClientHello length is %d, got %d payload bytes", helloLen, len(joined)-handshakeHeaderLen)
+	}
+
+	// An otherwise identical request with no trust roots must fail; the
+	// fragmentation layer must not relax crypto/tls certificate verification.
+	untrusted := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: x509.NewCertPool()}}
+	untrusted.DialContext = base.DialContext
+	untrustedClient := &http.Client{Transport: WrapTransport(untrusted)}
+	_, err = untrustedClient.Get(endpoint)
+	if err == nil || (!strings.Contains(strings.ToLower(err.Error()), "certificate") && !strings.Contains(strings.ToLower(err.Error()), "authority")) {
+		t.Fatalf("untrusted server certificate error = %v, want certificate verification failure", err)
+	}
+}
+
+func TestDisabledTransportIsUnchanged(t *testing.T) {
+	t.Setenv(EnabledEnv, "")
+	base := &http.Transport{}
+	if got := WrapTransport(base); got != base {
+		t.Fatal("disabled WrapTransport should return the original transport")
+	}
+}
+
+type writeCapture struct {
+	mu     sync.Mutex
+	writes [][]byte
+}
+
+func (c *writeCapture) add(data []byte) {
+	c.mu.Lock()
+	c.writes = append(c.writes, append([]byte(nil), data...))
+	c.mu.Unlock()
+}
+
+func (c *writeCapture) snapshot() [][]byte {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([][]byte, len(c.writes))
+	for i := range c.writes {
+		out[i] = append([]byte(nil), c.writes[i]...)
+	}
+	return out
+}
+
+type capturedConn struct {
+	net.Conn
+	capture *writeCapture
+}
+
+func (c *capturedConn) Write(p []byte) (int, error) {
+	c.capture.add(p)
+	return c.Conn.Write(p)
+}
