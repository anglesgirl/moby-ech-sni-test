diff --git a/daemon/internal/echtls/live_test.go b/daemon/internal/echtls/live_test.go
new file mode 100644
index 0000000..3a6a344
--- /dev/null
+++ b/daemon/internal/echtls/live_test.go
@@ -0,0 +1,321 @@
+package echtls
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// This live test is opt-in because it depends on public DNS and registry
+// availability. It tests, rather than assumes, whether Cloudflare's shared ECH
+// config can be used for Docker Hub's separate registry/auth/blob hostnames.
+func TestLiveCloudflareSharedECH(t *testing.T) {
+	if os.Getenv("MOBY_ECH_LIVE_TEST") != "1" {
+		t.Skip("set MOBY_ECH_LIVE_TEST=1 to test public Cloudflare and Docker endpoints")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+
+	list, err := cloudflarePublicECHConfig(ctx)
+	if err != nil {
+		t.Fatalf("fetch cloudflare-ech.com ECHConfigList: %v", err)
+	}
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	plainClient := &http.Client{Transport: http.DefaultTransport.(*http.Transport).Clone(), Timeout: 20 * time.Second}
+	client := &http.Client{
+		Transport: WrapTransport(base, staticSource(list)),
+		Timeout:   20 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) > 0 && req.URL.Hostname() != via[len(via)-1].URL.Hostname() {
+				t.Logf("redirect-host %s -> %s", via[len(via)-1].URL.Hostname(), req.URL.Hostname())
+			}
+			if len(via) >= 10 {
+				return fmt.Errorf("stopped after 10 redirects")
+			}
+			return nil
+		},
+	}
+
+	// Browser-observed positive control: the owner supplied a Cloudflare trace
+	// screenshot for hub.docker.com showing sni=encrypted and TLS 1.3.
+	traceResp, err := client.Get("https://hub.docker.com/cdn-cgi/trace")
+	if err != nil {
+		t.Logf("hub.docker.com error: %s", liveError(err))
+	} else {
+		trace, _ := io.ReadAll(io.LimitReader(traceResp.Body, 16<<10))
+		_ = traceResp.Body.Close()
+		t.Logf("hub.docker.com status=%s ech_accepted=%t tls=%s trace_encrypted=%t", traceResp.Status, traceResp.TLS != nil && traceResp.TLS.ECHAccepted, tlsVersion(traceResp), strings.Contains(string(trace), "sni=encrypted"))
+	}
+
+	// Registry API should answer 401 without credentials; the TLS state tells us
+	// whether this specific service accepted the shared ECH config.
+	registryResp, err := client.Get("https://registry-1.docker.io/v2/")
+	if err != nil {
+		t.Logf("registry-1.docker.io error: %s", liveError(err))
+	} else {
+		registryECH := registryResp.TLS != nil && registryResp.TLS.ECHAccepted
+		t.Logf("registry-1.docker.io status=%s ech_accepted=%t tls=%s", registryResp.Status, registryECH, tlsVersion(registryResp))
+		_ = registryResp.Body.Close()
+	}
+
+	// Acquire only a public pull token for the public hello-world image; never
+	// print or persist the token.
+	tokenURL := "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/hello-world:pull"
+	tokenResp, err := client.Get(tokenURL)
+	if err != nil {
+		t.Logf("auth.docker.io error: %s", liveError(err))
+		return
+	}
+	tokenECH := tokenResp.TLS != nil && tokenResp.TLS.ECHAccepted
+	t.Logf("auth.docker.io status=%s ech_accepted=%t tls=%s", tokenResp.Status, tokenECH, tlsVersion(tokenResp))
+	var tokenData struct {
+		Token       string `json:"token"`
+		AccessToken string `json:"access_token"`
+	}
+	if tokenResp.StatusCode == http.StatusOK {
+		if err := json.NewDecoder(io.LimitReader(tokenResp.Body, 1<<20)).Decode(&tokenData); err != nil {
+			_ = tokenResp.Body.Close()
+			t.Logf("decode auth token response: %T", err)
+			return
+		}
+	}
+	_ = tokenResp.Body.Close()
+	token := tokenData.Token
+	if token == "" {
+		token = tokenData.AccessToken
+	}
+	if token == "" {
+		t.Log("no public pull token returned; skipping manifest/blob host checks")
+		return
+	}
+
+	manifestURL := "https://registry-1.docker.io/v2/library/hello-world/manifests/latest"
+	manifestReq, _ := http.NewRequestWithContext(ctx, http.MethodGet, manifestURL, nil)
+	manifestReq.Header.Set("Authorization", "Bearer "+token)
+	manifestReq.Header.Set("Accept", strings.Join([]string{
+		"application/vnd.oci.image.index.v1+json",
+		"application/vnd.docker.distribution.manifest.list.v2+json",
+		"application/vnd.oci.image.manifest.v1+json",
+		"application/vnd.docker.distribution.manifest.v2+json",
+	}, ", "))
+	manifestResp, err := plainClient.Do(manifestReq)
+	if err != nil {
+		t.Logf("manifest request error: %T", err)
+		return
+	}
+	manifestECH := manifestResp.TLS != nil && manifestResp.TLS.ECHAccepted
+	t.Logf("manifest host=%s status=%s ech_accepted=%t tls=%s", manifestResp.Request.URL.Hostname(), manifestResp.Status, manifestECH, tlsVersion(manifestResp))
+	if manifestResp.StatusCode != http.StatusOK {
+		_ = manifestResp.Body.Close()
+		return
+	}
+	var image struct {
+		Manifests []struct {
+			Digest   string `json:"digest"`
+			Platform struct {
+				OS           string `json:"os"`
+				Architecture string `json:"architecture"`
+			} `json:"platform"`
+		} `json:"manifests"`
+		Layers []struct {
+			Digest string `json:"digest"`
+		} `json:"layers"`
+	}
+	manifestBytes, err := io.ReadAll(io.LimitReader(manifestResp.Body, 2<<20))
+	_ = manifestResp.Body.Close()
+	if err != nil {
+		t.Logf("read manifest: %T", err)
+		return
+	}
+	if err := json.Unmarshal(manifestBytes, &image); err != nil {
+		t.Logf("decode manifest: %T", err)
+		return
+	}
+	if len(image.Manifests) > 0 {
+		digest := image.Manifests[0].Digest
+		for _, candidate := range image.Manifests {
+			if candidate.Platform.OS == "linux" && candidate.Platform.Architecture == "amd64" {
+				digest = candidate.Digest
+				break
+			}
+		}
+		childURL := "https://registry-1.docker.io/v2/library/hello-world/manifests/" + digest
+		childReq, _ := http.NewRequestWithContext(ctx, http.MethodGet, childURL, nil)
+		childReq.Header.Set("Authorization", "Bearer "+token)
+		childReq.Header.Set("Accept", "application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json")
+		childResp, err := plainClient.Do(childReq)
+		if err != nil {
+			t.Logf("platform manifest request error: %T", err)
+			return
+		}
+		t.Logf("platform manifest host=%s status=%s ech_accepted=%t tls=%s", childResp.Request.URL.Hostname(), childResp.Status, childResp.TLS != nil && childResp.TLS.ECHAccepted, tlsVersion(childResp))
+		if childResp.StatusCode != http.StatusOK {
+			_ = childResp.Body.Close()
+			return
+		}
+		manifestBytes, err = io.ReadAll(io.LimitReader(childResp.Body, 2<<20))
+		_ = childResp.Body.Close()
+		if err != nil || json.Unmarshal(manifestBytes, &image) != nil {
+			t.Logf("could not decode platform manifest")
+			return
+		}
+	}
+	if len(image.Layers) == 0 {
+		t.Log("image manifest contains no layers")
+		return
+	}
+	blobURL := "https://registry-1.docker.io/v2/library/hello-world/blobs/" + image.Layers[0].Digest
+	plainBlobClient := &http.Client{
+		Transport: http.DefaultTransport.(*http.Transport).Clone(),
+		Timeout:   20 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	plainBlobReq, _ := http.NewRequestWithContext(ctx, http.MethodGet, blobURL, nil)
+	plainBlobReq.Header.Set("Authorization", "Bearer "+token)
+	plainBlobResp, err := plainBlobClient.Do(plainBlobReq)
+	if err != nil {
+		t.Logf("plain blob redirect request error: %s", liveError(err))
+		return
+	}
+	location, err := url.Parse(plainBlobResp.Header.Get("Location"))
+	plainStatus := plainBlobResp.Status
+	_ = plainBlobResp.Body.Close()
+	if err != nil || location.Hostname() == "" {
+		t.Logf("blob request did not yield an external redirect: status=%s", plainStatus)
+		return
+	}
+	t.Logf("actual blob redirect host=%s status=%s", location.Hostname(), plainStatus)
+	plainFollowClient := &http.Client{Transport: http.DefaultTransport.(*http.Transport).Clone(), Timeout: 20 * time.Second}
+	plainFollowReq, _ := http.NewRequestWithContext(ctx, http.MethodGet, blobURL, nil)
+	plainFollowReq.Header.Set("Authorization", "Bearer "+token)
+	plainFollowResp, err := plainFollowClient.Do(plainFollowReq)
+	if err != nil {
+		t.Logf("normal TLS blob request error: %s", liveError(err))
+	} else {
+		t.Logf("normal TLS blob final-host=%s status=%s tls=%s", plainFollowResp.Request.URL.Hostname(), plainFollowResp.Status, tlsVersion(plainFollowResp))
+		_ = plainFollowResp.Body.Close()
+	}
+
+	// Repeat the real blob request normally through the registry, but apply the
+	// shared ECHConfigList only to the observed blob redirect destination(s).
+	blobSource := &selectedHostsSource{list: list, hosts: make(map[string]struct{})}
+	blobSource.add(location.Hostname())
+	blobClient := &http.Client{
+		Transport: WrapTransport(http.DefaultTransport.(*http.Transport).Clone(), blobSource),
+		Timeout:   20 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) > 0 {
+				previous := via[len(via)-1].Response
+				if previous != nil {
+					t.Logf("blob hop host=%s ech_accepted=%t", previous.Request.URL.Hostname(), previous.TLS != nil && previous.TLS.ECHAccepted)
+				}
+			}
+			blobSource.add(req.URL.Hostname())
+			if len(via) >= 10 {
+				return fmt.Errorf("stopped after 10 redirects")
+			}
+			return nil
+		},
+	}
+	blobReq, _ := http.NewRequestWithContext(ctx, http.MethodGet, blobURL, nil)
+	blobReq.Header.Set("Authorization", "Bearer "+token)
+	blobResp, err := blobClient.Do(blobReq)
+	if err != nil {
+		t.Logf("ECH blob request error: %s", liveError(err))
+		return
+	}
+	t.Logf("blob final-host=%s status=%s ech_accepted=%t tls=%s", blobResp.Request.URL.Hostname(), blobResp.Status, blobResp.TLS != nil && blobResp.TLS.ECHAccepted, tlsVersion(blobResp))
+	_ = blobResp.Body.Close()
+}
+
+type selectedHostsSource struct {
+	list  []byte
+	mu    sync.RWMutex
+	hosts map[string]struct{}
+}
+
+func (s *selectedHostsSource) add(host string) {
+	s.mu.Lock()
+	s.hosts[canonicalHost(host)] = struct{}{}
+	s.mu.Unlock()
+}
+
+func (s *selectedHostsSource) ConfigList(_ context.Context, host string) ([]byte, time.Duration, error) {
+	s.mu.RLock()
+	_, ok := s.hosts[canonicalHost(host)]
+	s.mu.RUnlock()
+	if !ok {
+		return nil, time.Minute, nil
+	}
+	return append([]byte(nil), s.list...), time.Minute, nil
+}
+
+func liveError(err error) string {
+	var urlErr *url.Error
+	if errors.As(err, &urlErr) {
+		err = urlErr.Err
+	}
+	var rejected *tls.ECHRejectionError
+	if errors.As(err, &rejected) {
+		return fmt.Sprintf("ECH rejection (retry config bytes=%d)", len(rejected.RetryConfigList))
+	}
+	return fmt.Sprintf("%T: %s", err, err)
+}
+
+func cloudflarePublicECHConfig(ctx context.Context) ([]byte, error) {
+	endpoint := "https://cloudflare-dns.com/dns-query?name=cloudflare-ech.com&type=65"
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/dns-json")
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("DoH returned %s", resp.Status)
+	}
+	var answer struct {
+		Status int `json:"Status"`
+		Answer []struct {
+			Data string `json:"data"`
+		} `json:"Answer"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&answer); err != nil {
+		return nil, err
+	}
+	for _, rr := range answer.Answer {
+		for _, field := range strings.Fields(rr.Data) {
+			if value, ok := strings.CutPrefix(field, "ech="); ok {
+				return base64.StdEncoding.DecodeString(value)
+			}
+		}
+	}
+	return nil, fmt.Errorf("no ech= parameter in cloudflare-ech.com HTTPS answer (rcode %d)", answer.Status)
+}
+
+func tlsVersion(resp *http.Response) string {
+	if resp.TLS == nil {
+		return "none"
+	}
+	return tls.VersionName(resp.TLS.Version)
+}
+
+// Ensure net/url stays part of the live test's public URL handling in Go's
+// standard library when redirect behavior changes.
+var _ = (*url.URL).Hostname
diff --git a/daemon/internal/echtls/transport.go b/daemon/internal/echtls/transport.go
new file mode 100644
index 0000000..eb7cfba
--- /dev/null
+++ b/daemon/internal/echtls/transport.go
@@ -0,0 +1,387 @@
+// Package echtls adds opportunistic ECH support to Moby's registry HTTP clients.
+package echtls
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+// ConfigSource looks up the ECHConfigList advertised for host. A nil or empty
+// list means that the host has not advertised ECH. ttl is used by sources to
+// bound how long discovered data may be cached.
+type ConfigSource interface {
+	ConfigList(ctx context.Context, host string) (list []byte, ttl time.Duration, err error)
+}
+
+// DNSConfigSource discovers ECHConfigLists from HTTPS/SVCB DNS records and
+// caches each result for no longer than its DNS TTL.
+type DNSConfigSource struct {
+	resolvConf string
+	mu         sync.Mutex
+	cache      map[string]dnsCacheEntry
+}
+
+type dnsCacheEntry struct {
+	list      []byte
+	expiresAt time.Time
+}
+
+// NewDNSConfigSource creates a source using the system's resolv.conf file.
+// This is a small cross-platform-aware prototype; platforms without a
+// resolv.conf (notably Windows) will simply report discovery errors, which the
+// transport treats as absence of an optional ECH advertisement.
+func NewDNSConfigSource() *DNSConfigSource {
+	return &DNSConfigSource{resolvConf: "/etc/resolv.conf", cache: make(map[string]dnsCacheEntry)}
+}
+
+var (
+	defaultSourceOnce sync.Once
+	defaultSource     *DNSConfigSource
+)
+
+// DefaultConfigSource returns a process-wide source so registry host clients
+// share DNS results and refresh them at the advertised TTL.
+func DefaultConfigSource() ConfigSource {
+	defaultSourceOnce.Do(func() { defaultSource = NewDNSConfigSource() })
+	return defaultSource
+}
+
+func (s *DNSConfigSource) ConfigList(ctx context.Context, host string) ([]byte, time.Duration, error) {
+	host = canonicalHost(host)
+	if host == "" || net.ParseIP(host) != nil {
+		return nil, time.Minute, nil
+	}
+
+	now := time.Now()
+	s.mu.Lock()
+	entry, ok := s.cache[host]
+	if ok && now.Before(entry.expiresAt) {
+		list := append([]byte(nil), entry.list...)
+		ttl := time.Until(entry.expiresAt)
+		s.mu.Unlock()
+		return list, ttl, nil
+	}
+	s.mu.Unlock()
+
+	list, ttl, err := s.lookup(ctx, host)
+	if err != nil {
+		return nil, 0, err
+	}
+	if ttl <= 0 {
+		ttl = time.Second
+	}
+	s.mu.Lock()
+	s.cache[host] = dnsCacheEntry{list: append([]byte(nil), list...), expiresAt: time.Now().Add(ttl)}
+	s.mu.Unlock()
+	return append([]byte(nil), list...), ttl, nil
+}
+
+func canonicalHost(host string) string {
+	host = strings.TrimSuffix(strings.TrimSpace(host), ".")
+	return strings.ToLower(strings.Trim(host, "[]"))
+}
+
+func (s *DNSConfigSource) lookup(ctx context.Context, host string) ([]byte, time.Duration, error) {
+	name := dns.Fqdn(host)
+	var ttl time.Duration
+	for hop := 0; hop < 8; hop++ {
+		msg := new(dns.Msg)
+		msg.SetQuestion(name, dns.TypeHTTPS)
+		response, err := s.exchange(ctx, msg)
+		if err != nil {
+			return nil, 0, err
+		}
+		if response.Rcode == dns.RcodeNameError {
+			return nil, minTTL(ttl, negativeTTL(response)), nil
+		}
+		if response.Rcode != dns.RcodeSuccess {
+			return nil, 0, fmt.Errorf("HTTPS DNS query for %s: %s", name, dns.RcodeToString[response.Rcode])
+		}
+
+		var alias string
+		for _, answer := range response.Answer {
+			rr, ok := answer.(*dns.HTTPS)
+			if !ok {
+				continue
+			}
+			rrTTL := time.Duration(rr.Hdr.Ttl) * time.Second
+			if rr.Priority == 0 {
+				alias = strings.TrimSuffix(rr.Target, ".")
+				ttl = minTTL(ttl, rrTTL)
+				break
+			}
+			for _, value := range rr.Value {
+				if ech, ok := value.(*dns.SVCBECHConfig); ok && len(ech.ECH) != 0 {
+					return append([]byte(nil), ech.ECH...), minTTL(ttl, rrTTL), nil
+				}
+			}
+			ttl = minTTL(ttl, rrTTL)
+		}
+		if alias != "" && alias != "." {
+			name = dns.Fqdn(alias)
+			continue
+		}
+		return nil, minTTL(ttl, negativeTTL(response)), nil
+	}
+	return nil, 0, fmt.Errorf("too many HTTPS DNS alias records for %s", host)
+}
+
+func (s *DNSConfigSource) exchange(ctx context.Context, msg *dns.Msg) (*dns.Msg, error) {
+	config, err := dns.ClientConfigFromFile(s.resolvConf)
+	if err != nil {
+		return nil, fmt.Errorf("load DNS resolver configuration: %w", err)
+	}
+	if len(config.Servers) == 0 {
+		return nil, errors.New("DNS resolver configuration has no name servers")
+	}
+	timeout := time.Duration(config.Timeout) * time.Second
+	if timeout <= 0 {
+		timeout = 2 * time.Second
+	}
+	var lastErr error
+	for _, server := range config.Servers {
+		address := net.JoinHostPort(server, config.Port)
+		client := &dns.Client{Net: "udp", Timeout: timeout}
+		response, _, err := client.ExchangeContext(ctx, msg, address)
+		if err == nil && response.Truncated {
+			client.Net = "tcp"
+			response, _, err = client.ExchangeContext(ctx, msg, address)
+		}
+		if err == nil {
+			return response, nil
+		}
+		lastErr = err
+	}
+	return nil, fmt.Errorf("query HTTPS DNS records: %w", lastErr)
+}
+
+func negativeTTL(msg *dns.Msg) time.Duration {
+	for _, rr := range msg.Ns {
+		if soa, ok := rr.(*dns.SOA); ok {
+			ttl := soa.Hdr.Ttl
+			if soa.Minttl < ttl {
+				ttl = soa.Minttl
+			}
+			if ttl > 0 {
+				return time.Duration(ttl) * time.Second
+			}
+		}
+	}
+	return time.Minute
+}
+
+func minTTL(a, b time.Duration) time.Duration {
+	if a <= 0 || b < a {
+		return b
+	}
+	return a
+}
+
+// Transport wraps an *http.Transport and adds ECH when its ConfigSource has an
+// HTTPS/SVCB ECHConfigList for the request's actual TLS hostname. Requests
+// without an advertisement use the original transport unchanged.
+type Transport struct {
+	base   *http.Transport
+	source ConfigSource
+
+	mu         sync.Mutex
+	transports map[string]cachedTransport
+}
+
+type cachedTransport struct {
+	fingerprint [32]byte
+	transport   *http.Transport
+}
+
+// WrapTransport wraps base. If base is not an *http.Transport, it is returned
+// unchanged because cloning an opaque RoundTripper could lose TLS policy.
+func WrapTransport(base *http.Transport, source ConfigSource) *Transport {
+	if source == nil {
+		source = DefaultConfigSource()
+	}
+	return &Transport{base: base, source: source, transports: make(map[string]cachedTransport)}
+}
+
+func (t *Transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL == nil || req.URL.Scheme != "https" {
+		return t.base.RoundTrip(req)
+	}
+	host := canonicalHost(req.URL.Hostname())
+	if host == "" || net.ParseIP(host) != nil || t.base.DialTLS != nil || t.base.DialTLSContext != nil {
+		return t.base.RoundTrip(req)
+	}
+	list, _, err := t.source.ConfigList(req.Context(), host)
+	if err != nil || len(list) == 0 {
+		// ECH is opportunistic: DNS failures or no advertisement preserve the
+		// existing, normally verified TLS path. Once ECH is attempted, however,
+		// a rejection is never silently downgraded to plaintext SNI.
+		return t.base.RoundTrip(req)
+	}
+
+	tr, err := t.transportFor(host, list)
+	if err != nil {
+		return nil, err
+	}
+	capture := &dialCapture{}
+	ctx := context.WithValue(req.Context(), dialCaptureKey{}, capture)
+	attempt := req.Clone(ctx)
+	resp, err := tr.RoundTrip(attempt)
+	if err == nil {
+		return resp, nil
+	}
+
+	var rejection *tls.ECHRejectionError
+	if !errors.As(err, &rejection) || len(rejection.RetryConfigList) == 0 || !replayable(req) {
+		return nil, err
+	}
+	if isProxied(t.base, req) {
+		// A proxy controls origin DNS and may route the retry to a different
+		// server. RFC 9849 forbids using addresses learned after rejection.
+		return nil, err
+	}
+	pinnedAddr := capture.address()
+	if !isPinnedIPAddr(pinnedAddr) {
+		return nil, err
+	}
+	retryReq, err := cloneForRetry(req)
+	if err != nil {
+		return nil, err
+	}
+	retryTransport, err := t.newTransport(rejection.RetryConfigList, pinnedAddr)
+	if err != nil {
+		return nil, err
+	}
+	defer retryTransport.CloseIdleConnections()
+	return retryTransport.RoundTrip(retryReq)
+}
+
+// CloseIdleConnections preserves http.Client's connection cleanup behavior for
+// both the baseline transport and the per-host ECH transports.
+func (t *Transport) CloseIdleConnections() {
+	t.base.CloseIdleConnections()
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for _, cached := range t.transports {
+		cached.transport.CloseIdleConnections()
+	}
+}
+
+func (t *Transport) transportFor(host string, list []byte) (*http.Transport, error) {
+	fingerprint := sha256.Sum256(list)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if cached, ok := t.transports[host]; ok && cached.fingerprint == fingerprint {
+		return cached.transport, nil
+	}
+	tr, err := t.newTransport(list, "")
+	if err != nil {
+		return nil, err
+	}
+	if old, ok := t.transports[host]; ok {
+		old.transport.CloseIdleConnections()
+	}
+	t.transports[host] = cachedTransport{fingerprint: fingerprint, transport: tr}
+	return tr, nil
+}
+
+func (t *Transport) newTransport(list []byte, pinnedAddr string) (*http.Transport, error) {
+	tr := t.base.Clone()
+	if tr.TLSClientConfig != nil {
+		tr.TLSClientConfig = tr.TLSClientConfig.Clone()
+	} else {
+		tr.TLSClientConfig = &tls.Config{}
+	}
+	config := tr.TLSClientConfig
+	if config.MaxVersion != 0 && config.MaxVersion < tls.VersionTLS13 {
+		return nil, errors.New("ECH requires TLS 1.3 but the registry TLS configuration sets a lower maximum")
+	}
+	if config.MinVersion > tls.VersionTLS13 {
+		return nil, errors.New("ECH requires TLS 1.3 but the registry TLS configuration sets a higher minimum")
+	}
+	if config.MinVersion < tls.VersionTLS13 {
+		config.MinVersion = tls.VersionTLS13
+	}
+	config.EncryptedClientHelloConfigList = append([]byte(nil), list...)
+
+	dial := tr.DialContext
+	if dial == nil {
+		d := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}
+		dial = d.DialContext
+	}
+	if pinnedAddr != "" {
+		tr.DialContext = func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return dial(ctx, network, pinnedAddr)
+		}
+	} else {
+		tr.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+			conn, err := dial(ctx, network, addr)
+			if err == nil {
+				if capture, ok := ctx.Value(dialCaptureKey{}).(*dialCapture); ok {
+					capture.set(conn.RemoteAddr().String())
+				}
+			}
+			return conn, err
+		}
+	}
+	return tr, nil
+}
+
+func isProxied(tr *http.Transport, req *http.Request) bool {
+	if tr.Proxy == nil {
+		return false
+	}
+	proxy, err := tr.Proxy(req)
+	return err != nil || proxy != nil
+}
+
+func replayable(req *http.Request) bool {
+	return req.Body == nil || req.Body == http.NoBody || req.GetBody != nil
+}
+
+func cloneForRetry(req *http.Request) (*http.Request, error) {
+	retry := req.Clone(req.Context())
+	if req.Body != nil && req.Body != http.NoBody {
+		body, err := req.GetBody()
+		if err != nil {
+			return nil, err
+		}
+		retry.Body = body
+	}
+	return retry, nil
+}
+
+func isPinnedIPAddr(addr string) bool {
+	host, port, err := net.SplitHostPort(addr)
+	return err == nil && port != "" && net.ParseIP(host) != nil
+}
+
+type dialCaptureKey struct{}
+type dialCapture struct {
+	mu   sync.Mutex
+	addr string
+}
+
+func (c *dialCapture) set(addr string) {
+	c.mu.Lock()
+	c.addr = addr
+	c.mu.Unlock()
+}
+
+func (c *dialCapture) address() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.addr
+}
+
+// Compile-time check: Transport intentionally implements net/http's contract.
+var _ http.RoundTripper = (*Transport)(nil)
diff --git a/daemon/internal/echtls/transport_test.go b/daemon/internal/echtls/transport_test.go
new file mode 100644
index 0000000..2cb6491
--- /dev/null
+++ b/daemon/internal/echtls/transport_test.go
@@ -0,0 +1,204 @@
+package echtls
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.org/x/crypto/cryptobyte"
+)
+
+type staticSource []byte
+
+func (s staticSource) ConfigList(context.Context, string) ([]byte, time.Duration, error) {
+	return append([]byte(nil), s...), time.Minute, nil
+}
+
+func TestECHRequestAndSafeRetry(t *testing.T) {
+	cert, roots := testCertificate(t)
+	staleConfig, _ := testECHConfig(t, 1)
+	retryConfig, retryKey := testECHConfig(t, 2)
+	var requests atomic.Int32
+	var dialArgs []string
+	var dialMu sync.Mutex
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if r.TLS == nil || !r.TLS.ECHAccepted || r.TLS.ServerName != "secret.example" {
+			http.Error(w, "ECH was not accepted for the inner name", http.StatusBadRequest)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	server.TLS = &tls.Config{
+		MinVersion:               tls.VersionTLS13,
+		Certificates:             []tls.Certificate{cert},
+		EncryptedClientHelloKeys: []tls.EncryptedClientHelloKey{{Config: retryConfig, PrivateKey: retryKey, SendAsRetry: true}},
+	}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+
+	base, endpoint := testTransport(t, server, roots, &dialArgs, &dialMu)
+	client := &http.Client{Transport: WrapTransport(base, staticSource(echConfigList(staleConfig)))}
+	resp, err := client.Get("https://secret.example" + endpoint.Path)
+	if err != nil {
+		t.Fatalf("ECH request with authenticated retry config failed: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("unexpected status: %s", resp.Status)
+	}
+	if got := requests.Load(); got != 1 {
+		t.Fatalf("server received %d HTTP requests, want 1", got)
+	}
+	dialMu.Lock()
+	gotDialArgs := append([]string(nil), dialArgs...)
+	dialMu.Unlock()
+	if len(gotDialArgs) < 2 {
+		t.Fatalf("DialContext called %d times, want initial and pinned retry dials", len(gotDialArgs))
+	}
+	if addr, _, err := net.SplitHostPort(gotDialArgs[1]); err != nil || net.ParseIP(addr) == nil {
+		t.Fatalf("retry dial was not pinned to a numeric IP: %q", gotDialArgs[1])
+	}
+}
+
+func TestECHRejectionDoesNotDowngradeAndVerifiesPublicName(t *testing.T) {
+	cert, roots := testCertificate(t)
+	config, _ := testECHConfig(t, 3)
+	var requests atomic.Int32
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	// No ECH key: this server rejects ECH and cannot provide retry configs.
+	server.TLS = &tls.Config{MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{cert}}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+
+	base, endpoint := testTransport(t, server, roots, nil, nil)
+	client := &http.Client{Transport: WrapTransport(base, staticSource(echConfigList(config)))}
+	_, err := client.Get("https://secret.example" + endpoint.Path)
+	var rejection *tls.ECHRejectionError
+	if !errors.As(err, &rejection) {
+		t.Fatalf("got %v, want verified ECHRejectionError", err)
+	}
+	if got := requests.Load(); got != 0 {
+		t.Fatalf("ECH rejection sent %d HTTP requests; want no request and no plaintext retry", got)
+	}
+
+	// The public-name certificate must still chain to configured roots.
+	untrustedBase, endpoint := testTransport(t, server, x509.NewCertPool(), nil, nil)
+	untrustedClient := &http.Client{Transport: WrapTransport(untrustedBase, staticSource(echConfigList(config)))}
+	_, err = untrustedClient.Get("https://secret.example" + endpoint.Path)
+	if errors.As(err, &rejection) {
+		t.Fatalf("untrusted ECH provider certificate was accepted as a retry signal: %v", err)
+	}
+	if !strings.Contains(err.Error(), "certificate") && !strings.Contains(err.Error(), "authority") {
+		t.Fatalf("got %v, want certificate verification error", err)
+	}
+}
+
+func testTransport(t *testing.T, server *httptest.Server, roots *x509.CertPool, dialArgs *[]string, dialMu *sync.Mutex) (*http.Transport, *url.URL) {
+	t.Helper()
+	endpoint, err := url.Parse(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	base := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}}
+	base.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+		if dialArgs != nil {
+			dialMu.Lock()
+			*dialArgs = append(*dialArgs, addr)
+			dialMu.Unlock()
+		}
+		return (&net.Dialer{}).DialContext(ctx, network, endpoint.Host)
+	}
+	return base, endpoint
+}
+
+func testCertificate(t *testing.T) (tls.Certificate, *x509.CertPool) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "ECH test"},
+		DNSNames:     []string{"secret.example", "public.example"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		IsCA:         true,
+		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pair, err := tls.X509KeyPair(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: mustMarshalECKey(t, key)}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	return pair, roots
+}
+
+func mustMarshalECKey(t *testing.T, key *ecdsa.PrivateKey) []byte {
+	t.Helper()
+	der, err := x509.MarshalECPrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return der
+}
+
+func testECHConfig(t *testing.T, id uint8) ([]byte, []byte) {
+	t.Helper()
+	privateKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config cryptobyte.Builder
+	config.AddUint16(0xfe0d)
+	config.AddUint16LengthPrefixed(func(b *cryptobyte.Builder) {
+		b.AddUint8(id)
+		b.AddUint16(0x0020) // DHKEM(X25519, HKDF-SHA256)
+		b.AddUint16LengthPrefixed(func(b *cryptobyte.Builder) { b.AddBytes(privateKey.PublicKey().Bytes()) })
+		b.AddUint16LengthPrefixed(func(b *cryptobyte.Builder) {
+			b.AddUint16(0x0001) // HKDF-SHA256
+			b.AddUint16(0x0001) // AES-128-GCM
+		})
+		b.AddUint8(32)
+		b.AddUint8LengthPrefixed(func(b *cryptobyte.Builder) { b.AddBytes([]byte("public.example")) })
+		b.AddUint16(0)
+	})
+	return config.BytesOrPanic(), privateKey.Bytes()
+}
+
+func echConfigList(config []byte) []byte {
+	var list cryptobyte.Builder
+	list.AddUint16LengthPrefixed(func(b *cryptobyte.Builder) { b.AddBytes(config) })
+	return list.BytesOrPanic()
+}
