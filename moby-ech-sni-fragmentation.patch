new file mode 100644
index 0000000..f8d026b
--- /dev/null
+++ b/daemon/internal/tlsfragment/proxy_test.go
@@ -0,0 +1,126 @@
+package tlsfragment
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func TestClientHelloFragmentsThroughAuthenticatedHTTPProxy(t *testing.T) {
+	t.Setenv(EnabledEnv, "1")
+	registryServer := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(registryServer.Close)
+	registryURL, err := url.Parse(registryServer.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(registryServer.TLS.Certificates[0].Certificate[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverName := ""
+	if len(cert.DNSNames) > 0 {
+		serverName = cert.DNSNames[0]
+	} else if len(cert.IPAddresses) > 0 {
+		serverName = cert.IPAddresses[0].String()
+	} else {
+		t.Fatal("test TLS certificate has no DNS or IP subject alternative name")
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+
+	proxyAuth := make(chan string, 1)
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodConnect {
+			http.Error(w, "expected CONNECT", http.StatusMethodNotAllowed)
+			return
+		}
+		proxyAuth <- r.Header.Get("Proxy-Authorization")
+		hijacker, ok := w.(http.Hijacker)
+		if !ok {
+			http.Error(w, "hijacking unsupported", http.StatusInternalServerError)
+			return
+		}
+		clientConn, buffered, err := hijacker.Hijack()
+		if err != nil {
+			return
+		}
+		upstream, err := net.Dial("tcp", registryURL.Host)
+		if err != nil {
+			_, _ = io.WriteString(clientConn, "HTTP/1.1 502 Bad Gateway\r\n\r\n")
+			_ = clientConn.Close()
+			return
+		}
+		_, _ = io.WriteString(clientConn, "HTTP/1.1 200 Connection Established\r\n\r\n")
+		go func() {
+			_, _ = io.Copy(upstream, buffered)
+			_ = upstream.Close()
+		}()
+		go func() {
+			_, _ = io.Copy(clientConn, upstream)
+			_ = clientConn.Close()
+		}()
+	}))
+	t.Cleanup(proxy.Close)
+	proxyURL, err := url.Parse(proxy.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	proxyURL.User = url.UserPassword("registry-proxy", "test-secret")
+
+	capture := &writeCapture{}
+	base := &http.Transport{
+		Proxy:           http.ProxyURL(proxyURL),
+		TLSClientConfig: &tls.Config{RootCAs: roots},
+	}
+	base.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := (&net.Dialer{}).DialContext(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		return &capturedConn{Conn: conn, capture: capture}, nil
+	}
+	transport := WrapTransport(base)
+	defer transport.CloseIdleConnections()
+	endpoint := "https://" + net.JoinHostPort(serverName, registryURL.Port()) + "/v2/"
+	resp, err := (&http.Client{Transport: transport}).Get(endpoint)
+	if err != nil {
+		t.Fatalf("HTTPS request through authenticated CONNECT proxy failed: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("unexpected registry response through proxy: %s", resp.Status)
+	}
+	if got := <-proxyAuth; got != "Basic cmVnaXN0cnktcHJveHk6dGVzdC1zZWNyZXQ=" {
+		t.Fatalf("proxy received Proxy-Authorization %q, want the configured Basic credentials", got)
+	}
+
+	var helloRecords int
+	for _, write := range capture.snapshot() {
+		if strings.HasPrefix(string(write), "CONNECT ") {
+			continue
+		}
+		if len(write) >= tlsRecordHeaderLen && write[0] == tlsHandshakeRecordType {
+			if int(binary.BigEndian.Uint16(write[3:5])) != len(write)-tlsRecordHeaderLen {
+				t.Fatalf("proxied TLS record length header does not match bytes")
+			}
+			if len(write)-tlsRecordHeaderLen > defaultRecordPayloadLimit {
+				t.Fatalf("proxied TLS record payload exceeds configured limit")
+			}
+			helloRecords++
+		}
+	}
+	if helloRecords < 2 {
+		t.Fatalf("observed %d proxied TLS handshake records, want fragmented ClientHello", helloRecords)
+	}
+}
diff --git a/daemon/internal/tlsfragment/transport.go b/daemon/internal/tlsfragment/transport.go
new file mode 100644
index 0000000..589c0ad
--- /dev/null
+++ b/daemon/internal/tlsfragment/transport.go
@@ -0,0 +1,135 @@
+// Package tlsfragment provides an opt-in prototype for splitting a TLS
+// ClientHello handshake message across multiple TLS records.
+//
+// It is intended for local experimentation only. Enable it by setting
+// MOBY_TLS_FRAGMENT_CLIENT_HELLO=1 in the daemon environment. The package keeps
+// net/http's proxy selection and TLS configuration intact; certificate
+// verification remains the responsibility of crypto/tls.
+package tlsfragment
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+const (
+	// EnabledEnv enables this experimental behavior when its value is exactly "1".
+	EnabledEnv = "MOBY_TLS_FRAGMENT_CLIENT_HELLO"
+
+	defaultRecordPayloadLimit = 128
+	tlsRecordHeaderLen        = 5
+	handshakeHeaderLen        = 4
+	tlsHandshakeRecordType    = 0x16
+	tlsClientHelloType        = 0x01
+)
+
+// WrapTransport clones base and wraps its dialed connections if the opt-in
+// environment variable is set. It returns base unchanged when disabled or when
+// a custom TLS dialer is configured, because those dialers own TLS record
+// generation and cannot be safely intercepted here.
+func WrapTransport(base *http.Transport) *http.Transport {
+	if base == nil || os.Getenv(EnabledEnv) != "1" || base.DialTLS != nil || base.DialTLSContext != nil {
+		return base
+	}
+
+	tr := base.Clone()
+	dial := tr.DialContext
+	if dial == nil {
+		dialer := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}
+		dial = dialer.DialContext
+	}
+	tr.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := dial(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		return &fragmentConn{Conn: conn, recordPayloadLimit: defaultRecordPayloadLimit}, nil
+	}
+	return tr
+}
+
+type fragmentConn struct {
+	net.Conn
+	recordPayloadLimit int
+
+	mu   sync.Mutex
+	done bool
+}
+
+// Write only rewrites the first complete TLS record containing a complete
+// ClientHello. Plain HTTP proxy CONNECT requests pass through untouched; this
+// lets the same wrapper work for both direct connections and HTTP proxies.
+func (c *fragmentConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	if c.done || !looksLikeHandshakeRecord(p) {
+		c.mu.Unlock()
+		return c.Conn.Write(p)
+	}
+	frames, ok := splitClientHelloRecord(p, c.recordPayloadLimit)
+	c.done = true
+	if !ok {
+		c.mu.Unlock()
+		return c.Conn.Write(p)
+	}
+
+	// Keep writes serialized: TLS record order is significant, and a connection
+	// may otherwise receive concurrent writes from callers.
+	defer c.mu.Unlock()
+	for _, frame := range frames {
+		n, err := c.Conn.Write(frame)
+		if err != nil {
+			return 0, err
+		}
+		if n != len(frame) {
+			return 0, io.ErrShortWrite
+		}
+	}
+	return len(p), nil
+}
+
+func looksLikeHandshakeRecord(p []byte) bool {
+	return len(p) > 0 && p[0] == tlsHandshakeRecordType
+}
+
+// splitClientHelloRecord returns TLS records whose concatenated handshake
+// payload is byte-for-byte identical to the original ClientHello. The incoming
+// write is left untouched unless it is exactly one complete ClientHello record
+// and needs splitting.
+func splitClientHelloRecord(record []byte, recordPayloadLimit int) ([][]byte, bool) {
+	if recordPayloadLimit <= 0 || len(record) < tlsRecordHeaderLen+handshakeHeaderLen || record[0] != tlsHandshakeRecordType {
+		return nil, false
+	}
+	payloadLen := int(binary.BigEndian.Uint16(record[3:5]))
+	if payloadLen != len(record)-tlsRecordHeaderLen || record[1] != 0x03 {
+		return nil, false
+	}
+	payload := record[tlsRecordHeaderLen:]
+	if payload[0] != tlsClientHelloType {
+		return nil, false
+	}
+	handshakeLen := int(payload[1])<<16 | int(payload[2])<<8 | int(payload[3])
+	if handshakeLen != len(payload)-handshakeHeaderLen || len(payload) <= recordPayloadLimit {
+		return nil, false
+	}
+
+	frames := make([][]byte, 0, (len(payload)+recordPayloadLimit-1)/recordPayloadLimit)
+	for offset := 0; offset < len(payload); offset += recordPayloadLimit {
+		end := min(offset+recordPayloadLimit, len(payload))
+		frame := make([]byte, tlsRecordHeaderLen+end-offset)
+		frame[0] = record[0]
+		copy(frame[1:3], record[1:3])
+		binary.BigEndian.PutUint16(frame[3:5], uint16(end-offset))
+		copy(frame[tlsRecordHeaderLen:], payload[offset:end])
+		frames = append(frames, frame)
+	}
+	if len(frames) < 2 {
+		return nil, false
+	}
+	return frames, true
+}
