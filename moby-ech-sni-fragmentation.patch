+func TestEnabledTransportPreservesProxyAndTLSSettings(t *testing.T) {
+	t.Setenv(EnabledEnv, "1")
+	proxyURL, err := url.Parse("http://proxy-user:proxy-pass@proxy.example:3128")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tlsConfig := &tls.Config{MinVersion: tls.VersionTLS12}
+	base := &http.Transport{
+		Proxy:           http.ProxyURL(proxyURL),
+		TLSClientConfig: tlsConfig,
+		ProxyConnectHeader: http.Header{
+			"Proxy-Authorization": []string{"Basic cHJveHktYXV0aA=="},
+		},
+	}
+
+	transport := WrapTransport(base)
+	request := httptest.NewRequest(http.MethodGet, "https://registry.example/v2/", nil)
+	selectedProxy, err := transport.Proxy(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if selectedProxy == nil || selectedProxy.String() != proxyURL.String() {
+		t.Fatalf("proxy selection changed: got %v, want %s", selectedProxy, proxyURL)
+	}
+	if transport.TLSClientConfig == nil || transport.TLSClientConfig.MinVersion != tlsConfig.MinVersion || transport.TLSClientConfig.InsecureSkipVerify != tlsConfig.InsecureSkipVerify {
+		t.Fatal("TLS verification settings changed while wrapping the transport")
+	}
+	if got := transport.ProxyConnectHeader.Get("Proxy-Authorization"); got != "Basic cHJveHktYXV0aA==" {
+		t.Fatalf("Proxy-Authorization CONNECT header changed: %q", got)
+	}
+}
