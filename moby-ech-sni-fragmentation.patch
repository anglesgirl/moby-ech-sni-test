@@ -0,0 +1,32 @@
+package tlsfragment
+
+import (
+	"net/http"
+	"os"
+	"testing"
+	"time"
+)
+
+// TestLiveDockerRegistryV2 is opt-in because it needs external DNS and network
+// access. It uses the public /v2/ endpoint without credentials; an HTTP 401 is
+// the expected registry response and demonstrates that TLS completed.
+func TestLiveDockerRegistryV2(t *testing.T) {
+	if os.Getenv("MOBY_TLS_FRAGMENT_CLIENT_HELLO_LIVE_TEST") != "1" {
+		t.Skip("set MOBY_TLS_FRAGMENT_CLIENT_HELLO_LIVE_TEST=1 to contact Docker Hub")
+	}
+	t.Setenv(EnabledEnv, "1")
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	transport := WrapTransport(base)
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 30 * time.Second}
+
+	resp, err := client.Get("https://registry-1.docker.io/v2/")
+	if err != nil {
+		t.Fatalf("GET /v2/ through fragmented ClientHello failed: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusUnauthorized && resp.StatusCode != http.StatusOK {
+		t.Fatalf("unexpected Docker Hub /v2/ response: %s", resp.Status)
+	}
+	t.Logf("Docker Hub /v2/ completed TLS and returned %s", resp.Status)
+}
